# Copy to .env and fill in. Never commit .env.
# Provider: gemini | openai_compat | anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=your-key-here
# Leave LLM_MODEL empty to use the default in lawyer/llm.py; model names change, so check your provider's docs.
LLM_MODEL=
# Only for openai_compat (e.g. https://api.groq.com/openai/v1, https://openrouter.ai/api/v1). Empty = OpenAI.
LLM_BASE_URL=
# Set to 0 if your openai_compat provider rejects response_format
LLM_JSON_MODE=1
# Seconds to wait for the model (free tiers can be slow)
LLM_TIMEOUT=120
# Pause between model calls when running tests/run_scenarios.py (avoids 429 rate limits)
SCENARIO_DELAY=15

PORT=8000
RETENTION_DAYS=30
RATE_LIMIT_PER_5MIN=40
# Amounts at or above this (INR) add a "substantial amount: see an advocate" flag
SUBSTANTIAL_AMOUNT_INR=200000
