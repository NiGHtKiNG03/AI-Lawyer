# For Streamlit Community Cloud: paste these into  App settings > Secrets  (NOT into the repo).
# For local testing: copy this file to .streamlit/secrets.toml (that file is git-ignored) and fill it in.
LLM_PROVIDER = "gemini"
LLM_API_KEY = "your-key-here"
LLM_MODEL = "gemini-3.5-flash-lite"
LLM_TIMEOUT = "120"
